# Required: Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: "Join to Create" Voice Lobby Channel ID
LOBBY_CHANNEL_ID=0

# Optional: Guild (Server) ID for instant slash command syncing during testing
TEST_GUILD_ID=0

# Optional: Custom path to ffmpeg executable (defaults to "ffmpeg")
FFMPEG_PATH=ffmpeg

# Optional: Path to Netscape-format cookies.txt for yt-dlp
YTDL_COOKIE=

# Optional: Twitch Drops Campaign Monitor
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_NOTIFY_CHANNEL_ID=0

# Optional: Built-in Web UI Control Panel (defaults to SERVER_PORT or 8080)
WEB_PORT=8080
WEB_PASSWORD=

# Optional: Standalone Custom Drops Feed Script (custom_drops_feed.py)
PERSONAL_DISCORD_USER_ID=
PERSONAL_DROPS_CHANNEL_ID=
PERSONAL_DROPS_WEBHOOK_URL=
PERSONAL_DROPS_GAMES=Rust,League of Legends,Dark and Darker
DROPS_COOLDOWN_HOURS=48
